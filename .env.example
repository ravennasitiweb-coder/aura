# Modello delle variabili d'ambiente. Copialo in .env.local e compila i valori.
# .env.local non va MAI su GitHub (è già escluso in .gitignore).
# Su Vercel le stesse variabili si impostano in Project → Settings → Environment Variables.

# --- Supabase (obbligatorie) ------------------------------------------------
# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (inizia con sb_publishable_)
# È pensata per stare nel browser: i dati sono protetti dalla Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Email di conferma (facoltative) ----------------------------------------
# Senza queste due, la prenotazione funziona ma non parte nessuna email.
# Resend → API Keys. EMAIL_FROM deve usare un dominio verificato su Resend.
RESEND_API_KEY=
EMAIL_FROM="Salone <prenotazioni@tuodominio.it>"

# --- Abbonamenti Stripe (facoltative) ---------------------------------------
# Senza queste, la pagina Abbonamento mostra "pagamenti non ancora attivi".
# Usa chiavi di TEST (sk_test_...) finché non sei pronto a incassare.
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint https://TUO-SITO/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Stripe → Product catalog: un prezzo mensile ricorrente per piano (price_...)
STRIPE_PRICE_SOLO=
STRIPE_PRICE_SALONE=
STRIPE_PRICE_STUDIO=
# Serve SOLO al webhook per salvare l'abbonamento. È SEGRETA: mai nel browser.
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...)
SUPABASE_SECRET_KEY=

# --- Attività giornaliera (facoltativa ma consigliata) ----------------------
# Vercel la usa per firmare l'avvio automatico di /api/cron/giornaliero
# (promemoria, riepilogo, recensioni, richiami). Una stringa lunga e casuale.
CRON_SECRET=
# Indirizzo pubblico del sito, usato nei link delle email
NEXT_PUBLIC_SITE_URL=https://smartbooking.ravennasiti.it
