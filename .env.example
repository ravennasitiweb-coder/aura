# Modello delle variabili d'ambiente. Copialo in .env.local e compila i valori.
# .env.local non va MAI su GitHub (è già escluso in .gitignore).

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (inizia con sb_publishable_)
# È pensata per stare nel browser: i dati sono protetti dalla Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
